# Local SQLite database. Prisma resolves this relative to the prisma directory.
DATABASE_URL="file:./dev.db"

# Optional: Resend API key for email delivery.
# Leave blank for local development if console fallback is supported.
RESEND_API_KEY=""

# Optional: public application URL used in password-reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: verified sender address for outbound email.
EMAIL_FROM=""
